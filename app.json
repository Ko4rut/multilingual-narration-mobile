{
  "expo": {
    "name": "multilingual-narration-mobile",
    "slug": "multilingual-narration-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/app-icon.png",
    "scheme": "multilingualnarrationmobile",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.toanthangne.multilingualnarrationmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/branding/app-icon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFE6",
          "image": "./assets/images/branding/splash-logo.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép ứng dụng dùng vị trí để hiển thị bạn trên bản đồ."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép ứng dụng dùng camera để quét mã QR.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "00e9dde1-40bc-4675-a4c0-1bf77093c0da"
      }
    }
  }
}
